---
import Layout from '../layouts/Layout.astro';
import { Content, frontmatter } from '../content/about.md';

const title = frontmatter.title ?? 'About | lef237';
const description = frontmatter.description ?? 'lef237 profile';

// Social brand icons are based on Simple Icons: https://simpleicons.org
import githubSvg from '../components/icons/github.svg?raw';
import xSvg from '../components/icons/x.svg?raw';
import hatenablogSvg from '../components/icons/hatenablog.svg?raw';
import emailSvg from '../components/icons/email.svg?raw';
import noteSvg from '../components/icons/note.svg?raw';
import speakerdeckSvg from '../components/icons/speakerdeck.svg?raw';
import zennSvg from '../components/icons/zenn.svg?raw';

// size: rendered icon size in px (same values as the homepage)
const links = [
	{ href: '/email', label: 'メール', svg: emailSvg, size: 15 },
	{ href: 'https://github.com/lef237', label: 'GitHub', svg: githubSvg, size: 18 },
	{ href: 'https://x.com/lef237', label: 'X', svg: xSvg, size: 15 },
	{ href: 'https://zenn.dev/lef237', label: 'Zenn', svg: zennSvg, size: 16 },
	{ href: 'https://speakerdeck.com/lef237', label: 'Speaker Deck', svg: speakerdeckSvg, size: 18 },
	{ href: 'https://note.com/lef237', label: 'note', svg: noteSvg, size: 12 },
	{ href: 'https://lef237.hatenablog.com/', label: 'はてなブログ', svg: hatenablogSvg, size: 18 },
];

// Softwareカードのタイトル横に出す、リンク先を示すアイコン（CSSのmaskで使う）
const toDataUri = (svg: string) => `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
const externalSvg =
	'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6"/><path d="M20 4 10 14"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>';
const iconVars = `--icon-github: ${toDataUri(githubSvg)}; --icon-external: ${toDataUri(externalSvg)};`;
---

<Layout title={title} description={description} lang="ja">
	<main class="page">
		<article class="card prose" style={iconVars}>
			<header class="profile">
				<img src="/lefzou.jpg" alt="" width="96" height="96" loading="eager" />
				<div>
					<h1>LEF</h1>
					<p class="id">@lef237</p>
					<div class="icon-links" role="group" aria-label="リンク一覧">
						{links.map(({ href, label, svg, size }) => {
							const isExternal = href.startsWith('http');
							return (
								<a href={href} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noreferrer' : undefined} aria-label={label} title={label} style={`--icon-size: ${size}px`}><Fragment set:html={svg} /></a>
							);
						})}
					</div>
				</div>
			</header>
			<Content />
			<p class="back"><a href="/">Back to home</a></p>
		</article>
	</main>
</Layout>

<style>
	.page {
		min-height: 100vh;
		padding: 28px;
		background: #f6f9fe;
		font-family: 'Avenir Next', 'Hiragino Sans', 'Noto Sans JP', sans-serif;
		color: #273143;
	}

	.card {
		width: min(840px, 100%);
		box-sizing: border-box;
		margin: 0 auto;
		background: #fff;
		border: 1px solid #e7eef8;
		border-radius: 20px;
		padding: 32px;
		box-shadow: 0 2px 14px rgba(28, 54, 94, 0.05);
	}

	.profile {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 20px;
		align-items: center;
		margin-bottom: 24px;
	}

	.profile img {
		border-radius: 999px;
		object-fit: cover;
		border: 2px solid #e9eff9;
	}

	.prose .profile h1 {
		margin: 0;
		line-height: 1.1;
	}

	.prose .profile .id {
		margin: 2px 0 12px;
		font-size: 0.92rem;
		font-weight: 600;
		color: #63728d;
	}

	.icon-links {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.prose .icon-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		color: #33415c;
		background: #f3f7fd;
		border: 1px solid #e1e9f6;
		border-radius: 50%;
		text-decoration: none;
		transition: transform 0.24s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.18s ease, box-shadow 0.24s ease;
	}

	.prose .icon-links a:hover {
		color: #33415c;
		background: #ecf2fb;
		transform: translateY(-2px);
		box-shadow: 0 6px 14px rgba(28, 54, 94, 0.12);
	}

	.icon-links :global(svg) {
		display: block;
		width: var(--icon-size);
		height: var(--icon-size);
		fill: currentColor;
	}

	.prose :global(h1),
	.prose :global(h2),
	.prose :global(h3) {
		color: #273143;
		line-height: 1.25;
	}

	.prose :global(h1) {
		margin: 0 0 24px;
		font-size: clamp(1.9rem, 4vw, 2.5rem);
	}

	.prose :global(h2) {
		margin: 52px 0 16px;
		padding: 2px 0 2px 12px;
		border-left: 4px solid #8fa9d8;
		font-size: 1.4rem;
		letter-spacing: 0.01em;
	}

	.prose :global(h3) {
		margin: 24px 0 8px;
		font-size: 1.05rem;
	}

	.prose :global(p),
	.prose :global(li) {
		line-height: 1.85;
		color: #4f5d74;
	}

	.prose :global(p) {
		margin: 0 0 12px;
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 18px;
		padding-left: 1.35rem;
	}

	.prose :global(li + li) {
		margin-top: 8px;
	}

	.prose :global(li > ul),
	.prose :global(li > ol) {
		margin-top: 8px;
		margin-bottom: 10px;
	}

	/* 子リストを持つ項目（作品名・発表タイトルなど）を見出しのように強調する */
	.prose > :global(ul:has(> li > ul)) {
		padding-left: 0;
		list-style: none;
	}

	.prose > :global(ul) > :global(li:has(> ul)) {
		font-weight: 650;
		color: #273143;
	}

	.prose > :global(ul) > :global(li:has(> ul) + li) {
		margin-top: 20px;
	}

	.prose > :global(ul) > :global(li:has(> ul)) > :global(a) {
		color: #273143;
		font-size: 1.05rem;
	}

	/* 説明行は小さく・薄くして親項目との差をつける */
	.prose > :global(ul) > :global(li) > :global(ul) {
		margin: 4px 0 0;
		padding-left: 0;
		list-style: none;
		font-weight: 400;
	}

	.prose > :global(ul) > :global(li) > :global(ul) > :global(li) {
		font-size: 0.93rem;
		line-height: 1.75;
		color: #66748c;
	}

	.prose > :global(ul) > :global(li) > :global(ul) > :global(li + li) {
		margin-top: 2px;
	}

	/* Software：作品をカードのグリッドで並べる（Markdownのリスト構造はそのまま） */
	.prose > :global(h2#software + p + ul) {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 14px;
	}

	.prose > :global(h2#software + p + ul) > :global(li) {
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: 16px 18px;
		background: #fbfcff;
		border: 1px solid #e7eef8;
		border-radius: 14px;
		transition: border-color 0.18s ease, box-shadow 0.18s ease;
	}

	.prose > :global(h2#software + p + ul) > :global(li:hover) {
		border-color: #d3dff2;
		box-shadow: 0 4px 14px rgba(28, 54, 94, 0.07);
	}

	/* 日本語を文節で折り返し、行頭の短い切れ端を減らす */
	.prose > :global(h2#software + p + ul) > :global(li) {
		word-break: auto-phrase;
		text-wrap: pretty;
	}

	/* タイトルは下線なしの太字。hover時だけ下線を出す */
	.prose > :global(h2#software + p + ul) > :global(li) > :global(a) {
		text-decoration-color: transparent;
	}

	.prose > :global(h2#software + p + ul) > :global(li) > :global(a:hover) {
		text-decoration: underline;
		text-decoration-color: #97a7c1;
	}

	/* タイトル横のアイコンでリンク先を示す：GitHubならGitHubアイコン、それ以外は外部リンクの矢印 */
	.prose > :global(h2#software + p + ul) > :global(li) > :global(a::after) {
		content: '';
		display: inline-block;
		width: 0.85em;
		height: 0.85em;
		margin-left: 0.4em;
		vertical-align: -0.08em;
		background-color: currentColor;
		opacity: 0.45;
		mask: var(--icon-external) center / contain no-repeat;
		transition: opacity 0.18s ease;
	}

	.prose > :global(h2#software + p + ul) > :global(li) > :global(a[href^='https://github.com/']::after) {
		mask-image: var(--icon-github);
	}

	.prose > :global(h2#software + p + ul) > :global(li) > :global(a:hover::after) {
		opacity: 0.8;
	}

	.prose > :global(h2#software + p + ul) > :global(li) > :global(ul) {
		display: flex;
		flex-direction: column;
		flex: 1;
		margin-top: 6px;
	}

	/* 説明の項目どうしは行間より広く離して、文のまとまりを見せる */
	.prose > :global(h2#software + p + ul) > :global(li) > :global(ul) > :global(li) {
		line-height: 1.65;
	}

	.prose > :global(h2#software + p + ul) > :global(li) > :global(ul) > :global(li + li) {
		margin-top: 6px;
	}

	/* リンク行はチップにして、カードの下端にそろえる */
	.prose > :global(h2#software + p + ul) > :global(li) > :global(ul) > :global(li:last-child:has(> a)) {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: auto;
		padding-top: 12px;
	}

	.prose > :global(h2#software + p + ul) > :global(li) > :global(ul) > :global(li:last-child:has(> a)) > :global(a) {
		display: inline-block;
		padding: 1px 10px;
		font-size: 0.8rem;
		line-height: 1.7;
		color: #3f4f69;
		background: #eef3fb;
		border: 1px solid #dde6f4;
		border-radius: 999px;
		text-decoration: none;
		transition: background-color 0.18s ease, border-color 0.18s ease;
	}

	.prose > :global(h2#software + p + ul) > :global(li) > :global(ul) > :global(li:last-child:has(> a)) > :global(a:hover) {
		color: #2f3b52;
		background: #e3ebf8;
		border-color: #cfdcf0;
	}

	.prose :global(a),
	.back a {
		color: #3f4f69;
		text-decoration: underline dotted;
		text-underline-offset: 3px;
		text-decoration-color: #c3cedf;
		overflow-wrap: anywhere;
		transition: color 0.18s ease, text-decoration-color 0.18s ease;
	}

	.prose :global(a:hover),
	.back a:hover {
		color: #2f3b52;
		text-decoration-color: #97a7c1;
	}

	.prose :global(code) {
		display: inline-block;
		padding: 1px 7px;
		border-radius: 6px;
		background: #eef4ff;
		border: 1px solid #dfe8f8;
		color: #273143;
		font-size: 0.95em;
		overflow-wrap: anywhere;
	}

	.prose :global(hr) {
		border: 0;
		border-top: 1px solid #ecf1f9;
		margin: 32px 0;
	}

	.back {
		margin: 28px 0 0;
		padding-top: 20px;
		border-top: 1px solid #ecf1f9;
	}

	@media (max-width: 560px) {
		.page {
			padding-top: calc(14px + env(safe-area-inset-top));
			padding-right: calc(12px + env(safe-area-inset-right));
			padding-bottom: calc(14px + env(safe-area-inset-bottom));
			padding-left: calc(12px + env(safe-area-inset-left));
		}

		.card {
			padding: 20px;
			border-radius: 16px;
		}

		.profile {
			gap: 14px;
		}

		.profile img {
			width: 72px;
			height: 72px;
		}

		.prose :global(h2) {
			margin-top: 40px;
			font-size: 1.25rem;
		}
	}
</style>
